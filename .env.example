# Motion Marketing Studio – configurare locală (copiază în .env; .env nu urcă niciodată pe Git)
# Toate cheile sunt OPȚIONALE. Fără ele studioul merge complet offline: voce Windows (sau fără voce),
# muzică sintetizată, efecte sintetizate.

# Voce TTS prin ElevenLabs (opțional). voice_id-ul se pune în brief (audio.voice.voiceId).
ELEVENLABS_API_KEY=
# ELEVENLABS_MODEL=eleven_multilingual_v2

# Voce TTS prin OpenAI (opțional). Vocea (alloy, echo, nova…) se pune în brief.
OPENAI_API_KEY=
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# Licența Remotion pentru companii (opțional). Persoanele fizice și firmele mici o pot folosi gratuit;
# vezi https://www.remotion.dev/license. Dacă ai o licență de companie, pune cheia aici.
REMOTION_LICENSE_KEY=

# Folder alternativ pentru proiecte (implicit: ./projects)
# MMS_PROJECTS_DIR=C:\dev\proiecte-reclame

# Portul Studio-ului (implicit 4321)
# MMS_STUDIO_PORT=4321

# Bugetul de apeluri plătite (voci din cloud) pe o rulare (implicit 60). Jurnalul: npm run mms -- usage <proiect>
# MMS_MAX_PAID_CALLS=60

# Bugetul cache-urilor care se pot reface (randări, cadre-cheie, mixuri), în GB (implicit 10)
# MMS_CACHE_MAX_GB=10

# Câte cadre se randează în paralel (număr sau procent din nuclee; implicit min(8, nuclee/2)).
# Măsoară pe mașina ta: npm run bench -- <proiect>
# MMS_RENDER_CONCURRENCY=8
