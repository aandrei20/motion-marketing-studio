{
  "name": "motion-marketing-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Studio reutilizabil de productie video pentru produse software, construit pe Remotion.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "studio": "tsx src/cli/index.ts studio",
    "remotion": "tsx src/cli/index.ts remotion-studio",
    "mms": "tsx src/cli/index.ts",
    "render": "tsx src/cli/index.ts render --final=1",
    "preview": "tsx src/cli/index.ts preview",
    "doctor": "tsx scripts/doctor.ts",
    "test": "vitest run",
    "test:render": "vitest run --config vitest.render.config.ts",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check . && tsx scripts/lint-rules.ts",
    "format": "biome format --write .",
    "registry": "tsx scripts/build-registry.ts",
    "e2e": "tsx scripts/e2e-demo.ts",
    "e2e:real": "tsx scripts/e2e-real.ts",
    "bench": "tsx scripts/bench-render.ts",
    "check": "npm run typecheck && npm run lint && npm test",
    "update": "git pull --ff-only && npm ci && npx remotion browser ensure && npx playwright install chromium && tsx scripts/setup.ts && tsx scripts/doctor.ts",
    "docs": "tsx scripts/build-docs.ts"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.534",
    "@remotion/cli": "4.0.534",
    "@remotion/player": "4.0.534",
    "@remotion/renderer": "4.0.534",
    "esbuild": "0.28.2",
    "fontkit": "2.0.4",
    "playwright": "1.64.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "remotion": "4.0.534",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@types/fontkit": "2.0.9",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
